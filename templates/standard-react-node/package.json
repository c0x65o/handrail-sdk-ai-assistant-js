{
  "name": "assistant-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0", "npm": ">=12.0.2" },
  "devEngines": {
    "runtime": { "name": "node", "version": "^22.22.2 || ^24.15.0 || >=26.0.0", "onFail": "error" },
    "packageManager": { "name": "npm", "version": ">=12.0.2", "onFail": "error" }
  },
  "allowScripts": { "esbuild": true },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.server.json",
    "check": "npm run typecheck && npm run build",
    "doctor": "tsx src/doctor.ts",
    "db:migrate": "tsx src/migrate.ts",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@handrail/ai-assistant": "__SCAFFOLD_PUBLIC_SDK_GIT_PIN__",
    "express": "5.2.1",
    "pg": "8.20.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.17.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "tsx": "4.23.1",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
